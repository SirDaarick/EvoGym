EVOGYM_ENV=development
EVOGYM_DEBUG=true

# Database connection URL (PostgreSQL required for development/production)
# Development (Docker local container on port 5433):
EVOGYM_DATABASE_URL=postgresql+psycopg://evogym:evogym_dev_password@localhost:5433/evogym_dev
# Production (VPS / Managed Postgres):
# EVOGYM_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# Security secrets and session TTLs
EVOGYM_ADMIN_TOKEN_SIGNING_SECRET=change-this-secret-to-at-least-32-chars-long
EVOGYM_ADMIN_SESSION_TTL_SECONDS=28800
EVOGYM_STAFF_SESSION_TTL_SECONDS=28800
EVOGYM_ADMIN_LOCKOUT_ATTEMPTS=5
EVOGYM_ADMIN_LOCKOUT_SECONDS=300
EVOGYM_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EVOGYM_AUTH_RATE_LIMIT_REQUESTS=1000
EVOGYM_AUTH_REQUEST_MAX_BYTES=8192
EVOGYM_AUTH_MAX_CONCURRENT_HASHES=4
EVOGYM_ADMIN_RECOVERY_TTL_SECONDS=1800
EVOGYM_ADMIN_RECOVERY_BASE_URL=http://localhost:5174/admin/recovery

# Browser API CORS access
EVOGYM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5180,http://127.0.0.1:5180

# Mercado Pago Point integration (leave empty or unset to use in-memory emulator)
# EVOGYM_MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
