EVOGYM_ENV=development
EVOGYM_DEBUG=false
# Optional browser API access: comma-separated exact frontend origins (no paths, wildcards, or credentials).
# Leave unset to deny cross-origin browser access.
# EVOGYM_CORS_ALLOWED_ORIGINS=https://reception.example,http://localhost:5173
# Database access is optional; provide EVOGYM_DATABASE_URL only when explicitly needed.
# EVOGYM_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# Required for POST /api/v1/auth/staff/sessions; choose a bounded server-side TTL (60..86400 seconds).
# EVOGYM_STAFF_SESSION_TTL_SECONDS=
