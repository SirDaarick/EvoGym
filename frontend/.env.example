# Enable the local demo entry explicitly. Missing, invalid, or false values stay API-only.
VITE_DEMO_MODE=false

# Choose the seed variety only when demo mode is explicitly enabled above.
VITE_USE_RICH_DEMO=true

# Explicit live reception mode only; no fallback to demo when either value is missing.
# Configure this frontend's exact origin in the backend EVOGYM_CORS_ALLOWED_ORIGINS allowlist.
VITE_API_BASE_URL=http://localhost:8000
VITE_BRANCH_ID=

# Set to 'true' to suppress mock and seed demo data across the app
# VITE_DISABLE_DEMO_DATA=true
